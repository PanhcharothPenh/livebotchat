# Telegram Bot Configuration
# Obtain this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Support Group / Admin Chat ID
# This can be a group ID (usually starts with -100...) or your personal Telegram User ID
ADMIN_CHAT_ID=-1001234567890

# Supabase Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use service_role secret key so the bot can read/write data bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Secret token for Telegram Webhook validation (recommended for Vercel)
WEBHOOK_SECRET=your_random_secret_string_here

# Optional: Welcome message sent to users on /start
WELCOME_MESSAGE="👋 Welcome to our Support Chat! Send us any question, message, or file here, and our support team will reply to you shortly."

# Optional: Message sent when a ticket is closed
TICKET_CLOSED_MESSAGE="✅ Your support session has been marked as resolved. If you need help again, feel free to send a new message!"
